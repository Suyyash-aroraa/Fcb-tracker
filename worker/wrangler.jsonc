{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fcb-tracker",
  "main": "src/entry.py",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["python_workers"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // The existing "fcb-tracker-fcb-data" namespace. Local `pywrangler dev` stores KV under .wrangler/state.
  "kv_namespaces": [{ "binding": "FCB_DATA", "id": "2e67e3f3dfef4430bc6f779ab8f1413d" }],
  // Every minute: follow live matches, and run whichever sync steps are due (see src/fcb/pipeline.py).
  "triggers": { "crons": ["* * * * *"] },
  // Workers Paid: allow a full sync (every source, every match summary) in one invocation.
  "limits": { "cpu_ms": 60000 },
  "observability": { "enabled": true }
}
