{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fcb-tracker",
  "main": "src/entry.py",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["python_workers"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Omitting "id" lets `wrangler deploy` provision the namespace automatically.
  // Local `wrangler dev` stores KV under .wrangler/state.
  "kv_namespaces": [{ "binding": "FCB_DATA" }],
  // Every minute: follow live matches, and run whichever sync steps are due (see src/fcb/pipeline.py).
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true }
}
